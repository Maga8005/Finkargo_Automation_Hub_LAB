# Application Settings
DEBUG=true
APP_NAME=Finkargo Automation Hub
PYTHON_VERSION=3.11.9

# Supabase Configuration
SUPABASE_URL=https://[project-id].supabase.co
SUPABASE_ANON_KEY=[anon-key]
SUPABASE_SERVICE_KEY=[service-key]
SUPABASE_JWT_SECRET=[jwt-secret]

# Security
SECRET_KEY=[generate-secret-key]
ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=30

# CORS (JSON array format required!)
# Note: Vercel preview URLs are handled by allow_origin_regex in main.py
CORS_ORIGINS=["http://localhost:5173","https://finkargo-automation-hub.vercel.app"]

# Database (provided by Supabase)
DATABASE_URL=postgresql://[connection-string]

# File Upload
MAX_UPLOAD_SIZE=10485760
SUPPORTED_FILE_TYPES=[".pdf",".jpg",".jpeg",".png",".xlsx",".xls"]

# Google Drive Configuration (for Facturación MX)
# ============================================
# Two credential options (env-based takes priority):
#
# Option 1 - PRODUCTION (Render): Base64-encoded or raw JSON service account credentials
# To encode: cat service-account.json | base64
# Or paste raw JSON as a single line
GOOGLE_DRIVE_CREDENTIALS_JSON=
#
# Option 2 - LOCAL DEVELOPMENT: Path to JSON credentials file
# Leave GOOGLE_DRIVE_CREDENTIALS_JSON empty to use this fallback
GOOGLE_DRIVE_CREDENTIALS_PATH=./credentials/drive-service-account.json
#
GOOGLE_DRIVE_FOLDER_ID=1A5fxY8LnJYs0QTO3aYHD10IuRIgebx46
GOOGLE_DRIVE_SCOPES=["https://www.googleapis.com/auth/drive"]

# Session Cache Configuration
SESSION_CACHE_TTL_MINUTES=30
MAX_ZIP_SIZE_MB=50

# Invoice Processing
SUPPORTED_INVOICE_FORMATS=[".xlsx",".xls"]
